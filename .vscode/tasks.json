{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Tailor: Configure Debug", "type": "process", "command": "cmake",
            "args": ["--preset", "debug"],
            "options": {"cwd": "${workspaceFolder}"},
            "osx": {"args": ["--preset", "debug", "-DCMAKE_OSX_SYSROOT=macosx"]},
            "hide": true, "problemMatcher": []
        },
        {
            "label": "Tailor: Configure Release", "type": "process", "command": "cmake",
            "args": ["--preset", "release"],
            "options": {"cwd": "${workspaceFolder}"},
            "osx": {"args": ["--preset", "release", "-DCMAKE_OSX_SYSROOT=macosx"]},
            "hide": true, "problemMatcher": []
        },
        {
            "label": "Tailor: Build Debug", "type": "process", "command": "cmake",
            "args": ["--build", "--preset", "debug", "--parallel", "4"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "Tailor: Configure Debug",
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "Tailor: Build Release", "type": "process", "command": "cmake",
            "args": ["--build", "--preset", "release", "--parallel", "4"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "Tailor: Configure Release", "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "Tailor: Test", "type": "process", "command": "ctest",
            "args": ["--preset", "debug"], "options": {"cwd": "${workspaceFolder}"},
            "osx": {"options": {"cwd": "${workspaceFolder}", "env": {"PATH": "${env:PATH}:/opt/homebrew/bin:/usr/local/bin"}}},
            "dependsOn": "Tailor: Build Debug", "group": {"kind": "test", "isDefault": true},
            "problemMatcher": []
        },
        {
            "label": "Tailor: Test Release", "type": "process", "command": "ctest",
            "args": ["--preset", "release"], "options": {"cwd": "${workspaceFolder}"},
            "osx": {"options": {"cwd": "${workspaceFolder}", "env": {"PATH": "${env:PATH}:/opt/homebrew/bin:/usr/local/bin"}}},
            "dependsOn": "Tailor: Build Release", "hide": true, "problemMatcher": []
        },
        {
            "label": "Tailor: Package Release", "type": "process", "command": "cmake",
            "args": ["--build", "--preset", "release", "--target", "install", "--parallel", "4"],
            "options": {"cwd": "${workspaceFolder}"}, "dependsOn": "Tailor: Test Release",
            "problemMatcher": ["$gcc", "$msCompile"]
        }
    ]
}
